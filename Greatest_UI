-- Button Creator (with frame parameter)
local buttonCounts = {}
local function createButton(frame, name, callback)
    local frameName = frame.Name
    if not buttonCounts[frameName] then
        buttonCounts[frameName] = 0
    end
    buttonCounts[frameName] = buttonCounts[frameName] + 1
    
    local button = Instance.new("TextButton")
    button.Size = UDim2.new(0.9, 0, 0, 30)
    button.Position = UDim2.new(0.05, 0, 0, (buttonCounts[frameName] - 1) * 35)
    button.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
    button.Text = name
    button.TextColor3 = Color3.fromRGB(255, 255, 255)
    button.Font = Enum.Font.SourceSans
    button.TextSize = 14
    button.Parent = frame
    button.MouseButton1Click:Connect(callback)
    return button
end

-- Toggle Button Creator
local function createToggleButton(frame, name, initialValue, callback)
    local button = createButton(frame, name .. ": " .. (initialValue and "ON" or "OFF"), function()
        initialValue = not initialValue
        button.Text = name .. ": " .. (initialValue and "ON" or "OFF")
        callback(initialValue)
    end)
    return button
end

-- Slider Creator
local function createSlider(frame, name, min, max, default, callback)
    local frameName = frame.Name
    if not buttonCounts[frameName] then
        buttonCounts[frameName] = 0
    end
    buttonCounts[frameName] = buttonCounts[frameName] + 1
    
    local sliderFrame = Instance.new("Frame")
    sliderFrame.Size = UDim2.new(0.9, 0, 0, 50)
    sliderFrame.Position = UDim2.new(0.05, 0, 0, (buttonCounts[frameName] - 1) * 55)
    sliderFrame.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
    sliderFrame.Parent = frame
    
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 0, 20)
    label.BackgroundTransparency = 1
    label.Text = name .. ": " .. default
    label.TextColor3 = Color3.fromRGB(255, 255, 255)
    label.Font = Enum.Font.SourceSans
    label.TextSize = 14
    label.Parent = sliderFrame
    
    local slider = Instance.new("TextButton")
    slider.Size = UDim2.new(1, -20, 0, 20)
    slider.Position = UDim2.new(0, 10, 0, 25)
    slider.BackgroundColor3 = Color3.fromRGB(80, 80, 80)
    slider.Text = "← " .. default .. " →"
    slider.TextColor3 = Color3.fromRGB(255, 255, 255)
    slider.Font = Enum.Font.SourceSans
    slider.TextSize = 12
    slider.Parent = sliderFrame
    
    local value = default
    slider.MouseButton1Click:Connect(function()
        value = value + 1
        if value > max then value = min end
        slider.Text = "← " .. value .. " →"
        label.Text = name .. ": " .. value
        callback(value)
    end)
    
    slider.MouseButton2Click:Connect(function()
        value = value - 1
        if value < min then value = max end
        slider.Text = "← " .. value .. " →"
        label.Text = name .. ": " .. value
        callback(value)
    end)
    
    return sliderFrame
end

