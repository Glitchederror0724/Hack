    if gameProcessed then return end
    if input.KeyCode == Enum.KeyCode.F then
        flying = not flying
    elseif input.KeyCode == Enum.KeyCode.LeftControl then
        dash(Camera.CFrame.LookVector)
    elseif input.KeyCode == Enum.KeyCode.T then
        teleportToMouse()
    end
end)

