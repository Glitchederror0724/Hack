-- Fly (Fixed)
local function fly()
    local character = LocalPlayer.Character
    if not character then return end
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return end
    
    -- Remove existing body movers
    local oldVelocity = rootPart:FindFirstChild("BodyVelocity")
    if oldVelocity then oldVelocity:Destroy() end
    local oldGyro = rootPart:FindFirstChild("BodyGyro")
    if oldGyro then oldGyro:Destroy() end
    
    -- Create new body movers
    local bodyVelocity = Instance.new("BodyVelocity")
    bodyVelocity.MaxForce = Vector3.new(1, 1, 1) * 100000
    bodyVelocity.Parent = rootPart
    
    local bodyGyro = Instance.new("BodyGyro")
    bodyGyro.MaxTorque = Vector3.new(1, 1, 1) * 100000
    bodyGyro.Parent = rootPart
    
    local moveDirection = Vector3.new()
    
    if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveDirection = moveDirection + Camera.CFrame.LookVector end
    if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveDirection = moveDirection - Camera.CFrame.LookVector end
    if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveDirection = moveDirection - Camera.CFrame.RightVector end
    if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveDirection = moveDirection + Camera.CFrame.RightVector end
    if UserInputService:IsKeyDown(Enum.KeyCode.Space) then moveDirection = moveDirection + Vector3.new(0, 1, 0) end
    if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then moveDirection = moveDirection - Vector3.new(0, 1, 0) end
    
    if moveDirection.Magnitude > 0 then
        moveDirection = moveDirection.Unit * settings.flySpeed
    end
    
    bodyVelocity.Velocity = moveDirection
    bodyGyro.CFrame = Camera.CFrame
end

-- ESP (Fixed)
local espObjects = {}
local function createESP(player)
    if player == LocalPlayer then return end
    
    local esp = Instance.new("BillboardGui")
    esp.Name = "ESP_" .. player.Name
    esp.Size = UDim2.new(0, 200, 0, 50)
    esp.AlwaysOnTop = true
    esp.Adornee = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    
    local textLabel = Instance.new("TextLabel")
    textLabel.Name = "NameLabel"
    textLabel.Size = UDim2.new(1, 0, 0, 30)
    textLabel.BackgroundTransparency = 1
    textLabel.Text = player.Name
    textLabel.TextColor3 = settings.espColor
    textLabel.Font = Enum.Font.SourceSansBold
    textLabel.TextSize = 16
    textLabel.TextStrokeTransparency = 0
    textLabel.Parent = esp
    
    local distanceLabel = Instance.new("TextLabel")
    distanceLabel.Name = "DistanceLabel"
    distanceLabel.Size = UDim2.new(1, 0, 0, 20)
    distanceLabel.Position = UDim2.new(0, 0, 1, 0)
    distanceLabel.BackgroundTransparency = 1
    distanceLabel.Text = ""
    distanceLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    distanceLabel.Font = Enum.Font.SourceSans
    distanceLabel.TextSize = 12
    distanceLabel.Parent = esp
    
    esp.Parent = ScreenGui
    espObjects[player] = esp
end

local function updateESP()
    if not settings.espEnabled then
        for _, esp in pairs(espObjects) do
            if esp then
                esp.Enabled = false
            end
        end
        return
    end
    
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local character = player.Character
            local rootPart = character and character:FindFirstChild("HumanoidRootPart")
            local esp = espObjects[player]
            
            if character and rootPart then
                if not esp then
                    createESP(player)
                    esp = espObjects[player]
                end
                
                if esp then
                    esp.Adornee = rootPart
                    esp.Enabled = true
                    
                    local localRootPart = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                    local distance = math.huge
                    if localRootPart then
                        distance = (localRootPart.Position - rootPart.Position).Magnitude
                        local nameLabel = esp:FindFirstChild("NameLabel")
                        local distanceLabel = esp:FindFirstChild("DistanceLabel")
                        if nameLabel then
                            nameLabel.Text = player.Name
                        end
                        if distanceLabel then
                            distanceLabel.Text = math.floor(distance) .. "m"
                        end
                    end
                    
                    if distance > settings.maxDistance then
                        esp.Enabled = false
                    end
                end
            else
                if esp then
                    esp.Enabled = false
                end
            end
        end
    end
end

-- Teleport (Improved)
local function teleportToMouse()
    local mouse = LocalPlayer:GetMouse()
    local target = mouse.Target
    if target then
        local character = LocalPlayer.Character
        if character and character:FindFirstChild("HumanoidRootPart") then
            local newCFrame = target.CFrame + Vector3.new(0, 5, 0)
            character:SetPrimaryPartCFrame(newCFrame)
            Camera.CFrame = CFrame.new(newCFrame.Position, newCFrame.Position + Camera.CFrame.LookVector)
        end
    end
end

-- Teleport to Player
local function teleportToPlayer(player)
    if player and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
        LocalPlayer.Character:SetPrimaryPartCFrame(player.Character.HumanoidRootPart.CFrame + Vector3.new(0, 5, 0))
    end
end

-- Dash
local function dash(direction)
    local character = LocalPlayer.Character
    if not character or dashing then return end
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return end
    
    dashing = true
    local bodyVelocity = Instance.new("BodyVelocity")
    bodyVelocity.MaxForce = Vector3.new(1, 1, 1) * 100000
    bodyVelocity.Velocity = direction * settings.dashSpeed
    bodyVelocity.Parent = rootPart
    
    task.delay(settings.dashDuration, function()
        bodyVelocity:Destroy()
        dashing = false
    end)
end

-- Fullbright
local function setFullbright(enabled)
    if enabled then
        Lighting.Ambient = Color3.new(1, 1, 1)
        Lighting.Brightness = 2
        Lighting.ClockTime = 12
        Lighting.FogEnd = 100000
        Lighting.FogStart = 0
        Lighting.GlobalShadows = false
    else
        Lighting.Ambient = Color3.new(0, 0, 0)
        Lighting.Brightness = 1
        Lighting.ClockTime = 14
        Lighting.FogEnd = 500
        Lighting.FogStart = 0
        Lighting.GlobalShadows = true
    end
end

-- FPS Boost
local function setFPSBoost(enabled)
    if enabled then
        settings.RenderQualityLevel = 1
        Lighting.GlobalShadows = false
    else
        settings.RenderQualityLevel = 10
        Lighting.GlobalShadows = true
    end
end

-- Anti-AFK
local function antiAFK()
    local virtualUser = game:GetService("VirtualUser")
    game:GetService("Players").LocalPlayer.Idled:Connect(function()
        virtualUser:CaptureController()
        virtualUser:ClickButton2(Vector2.new())
    end)
end

-- Auto-Reconnect
local function autoReconnect()
    while settings.autoReconnectEnabled do
        task.wait(1)
        if not LocalPlayer.Character then
            LocalPlayer:LoadCharacter()
        end
    end
end

-- Server Hop
local function serverHop()
    local placeId = game.PlaceId
    local jobId = game.JobId
    local servers = {}
    
    local success, result = pcall(function()
        return game:GetService("HttpService"):GetAsync("https://games.roblox.com/v1/games/" .. placeId .. "/servers/Public?limit=100")
    end)
    
    if success then
        for _, server in pairs(result.data) do
            if server.id ~= jobId and server.playing < server.maxPlayers then
                table.insert(servers, server.id)
            end
        end
    end
    
    if #servers > 0 then
        local randomServer = servers[math.random(1, #servers)]
        TeleportService:TeleportToPlaceInstance(placeId, randomServer)
    end
end

-- Spectate & Mimic
local function spectate(player)
    if player == LocalPlayer then return end
    
    spectating = true
    spectatedPlayer = player
    
    Camera.CameraSubject = player.Character and player.Character:FindFirstChild("Humanoid")
end

local function stopSpectate()
    spectating = false
    spectatedPlayer = nil
    Camera.CameraSubject = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid")
end

local function mimic()
    if spectatedPlayer and spectatedPlayer.Character then
        LocalPlayer.Character:SetPrimaryPartCFrame(spectatedPlayer.Character.HumanoidRootPart.CFrame)
    end
end

-- Search
local function search(query)
    local results = {}
    for _, player in pairs(Players:GetPlayers()) do
        if string.lower(player.Name):find(string.lower(query)) then
            table.insert(results, player)
        end
    end
    return results
end

-- Dex (Simplified)
local function openDex()
    local dexGui = Instance.new("ScreenGui")
    dexGui.Parent = LocalPlayer:WaitForChild("PlayerGui")
    
    local dexFrame = Instance.new("Frame")
    dexFrame.Size = UDim2.new(0, 300, 0, 400)
    dexFrame.Position = UDim2.new(0.5, -150, 0.5, -200)
    dexFrame.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    dexFrame.Parent = dexGui
    
    local dexTitle = Instance.new("TextLabel")
    dexTitle.Size = UDim2.new(1, 0, 0, 30)
    dexTitle.Text = "Dex Explorer"
    dexTitle.TextColor3 = Color3.fromRGB(255, 255, 255)
    dexTitle.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
    dexTitle.Parent = dexFrame
    
    local dexList = Instance.new("ScrollingFrame")
    dexList.Size = UDim2.new(1, 0, 1, -30)
    dexList.Position = UDim2.new(0, 0, 0, 30)
    dexList.BackgroundTransparency = 1
    dexList.Parent = dexFrame
    
    local function explore(instance, depth)
        if depth > 5 then return end
        for _, child in pairs(instance:GetChildren()) do
            local button = Instance.new("TextButton")
            button.Size = UDim2.new(1, 0, 0, 25)
            button.Position = UDim2.new(0, depth * 15, 0, 0)
            button.BackgroundTransparency = 1
            button.Text = child.Name .. " [" .. child.ClassName .. "]"
            button.TextXAlignment = Enum.TextXAlignment.Left
            button.TextColor3 = Color3.fromRGB(255, 255, 255)
            button.Font = Enum.Font.SourceSans
            button.TextSize = 12
            button.Parent = dexList
            
            button.MouseButton1Click:Connect(function()
                dexList:ClearAllChildren()
                explore(child, depth + 1)
            end)
        end
    end
    
    explore(game, 0)
end

