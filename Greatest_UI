-- Fly function (fixed)
local function fly()
    local character = LocalPlayer.Character
    if not character then return end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if not rootPart or not humanoid or humanoid.State == Enum.HumanoidStateType.Physics then return end

    local bodyVelocity = rootPart:FindFirstChild("DeltaFlyBV")
    local bodyGyro = rootPart:FindFirstChild("DeltaFlyBG")

    if not bodyVelocity then
        bodyVelocity = Instance.new("BodyVelocity")
        bodyVelocity.Name = "DeltaFlyBV"
        bodyVelocity.MaxForce = Vector3.new(100000, 100000, 100000)
        bodyVelocity.P = 1250
        bodyVelocity.Velocity = Vector3.new()
        bodyVelocity.Parent = rootPart
    end

    if not bodyGyro then
        bodyGyro = Instance.new("BodyGyro")
        bodyGyro.Name = "DeltaFlyBG"
        bodyGyro.MaxTorque = Vector3.new(100000, 100000, 100000)
        bodyGyro.P = 1250
        bodyGyro.CFrame = rootPart.CFrame
        bodyGyro.Parent = rootPart
    end

    local moveDirection = Vector3.new()
    local cf = Camera.CFrame

    if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveDirection = moveDirection + cf.LookVector end
    if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveDirection = moveDirection - cf.LookVector end
    if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveDirection = moveDirection - cf.RightVector end
    if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveDirection = moveDirection + cf.RightVector end
    if UserInputService:IsKeyDown(Enum.KeyCode.Space) then moveDirection = moveDirection + Vector3.new(0, 1, 0) end
    if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then moveDirection = moveDirection - Vector3.new(0, 1, 0) end

    if moveDirection.Magnitude > 0 then
        moveDirection = moveDirection.Unit * settings.flySpeed
    end

    bodyVelocity.Velocity = moveDirection
    bodyGyro.CFrame = cf
end

local function stopFly()
    local character = LocalPlayer.Character
    if character then
        local rootPart = character:FindFirstChild("HumanoidRootPart")
        if rootPart then
            local bv = rootPart:FindFirstChild("DeltaFlyBV")
            local bg = rootPart:FindFirstChild("DeltaFlyBG")
            if bv then bv:Destroy() end
            if bg then bg:Destroy() end
        end
    end
end

-- ESP system (completed)
local espObjects = {}

local function createESP(player)
    if player == LocalPlayer then return end
    if espObjects[player] then return end

    local esp = Instance.new("BillboardGui")
    esp.Name = "ESP_" .. player.Name
    esp.Size = UDim2.new(0, 200, 0, 50)
    esp.AlwaysOnTop = true
    esp.Adornee = player.Character and player.Character:FindFirstChild("Head") or nil
    esp.Parent = player.Character

    local textLabel = Instance.new("TextLabel")
    textLabel.Size = UDim2.new(1, 0, 1, 0)
    textLabel.BackgroundTransparency = 1
    textLabel.Text = player.Name
    textLabel.TextColor3 = settings.espColor
    textLabel.TextStrokeTransparency = 0
    textLabel.Font = Enum.Font.SourceSansBold
    textLabel.TextSize = 16
    textLabel.Parent = esp

    espObjects[player] = esp
end

local function updateESP()
    for player, esp in pairs(espObjects) do
        if not player.Parent or not player.Character or not player.Character:FindFirstChild("Head") then
            esp:Destroy()
            espObjects[player] = nil
        else
            esp.Adornee = player.Character.Head
            local distance = (LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") and (LocalPlayer.Character.HumanoidRootPart.Position - player.Character.Head.Position).Magnitude) or math.huge
            esp.TextLabel.Text = player.Name .. " [" .. math.floor(distance) .. "m]"
        end
    end
end

