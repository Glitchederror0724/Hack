-- Fly
local function fly()
    local character = LocalPlayer.Character
    if not character then return end
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return end
    
    local bodyVelocity = rootPart:FindFirstChild("BodyVelocity")
    if not bodyVelocity then
        bodyVelocity = Instance.new("BodyVelocity")
        bodyVelocity.MaxForce = Vector3.new(1, 1, 1) * 100000
        bodyVelocity.Parent = rootPart
    end
    
    local bodyGyro = rootPart:FindFirstChild("BodyGyro")
    if not bodyGyro then
        bodyGyro = Instance.new("BodyGyro")
        bodyGyro.MaxTorque = Vector3.new(1, 1, 1) * 100000
        bodyGyro.Parent = rootPart
    end
    
    local moveDirection = Vector3.new()
    
    if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveDirection = moveDirection + Camera.CFrame.LookVector end
    if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveDirection = moveDirection - Camera.CFrame.LookVector end
    if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveDirection = moveDirection - Camera.CFrame.RightVector end
    if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveDirection = moveDirection + Camera.CFrame.RightVector end
    if UserInputService:IsKeyDown(Enum.KeyCode.Space) then moveDirection = moveDirection + Vector3.new(0, 1, 0) end
    if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then moveDirection = moveDirection - Vector3.new(0, 1, 0) end
    
    if moveDirection.Magnitude > 0 then
        moveDirection = moveDirection.Unit * settings.flySpeed
    end
    
    bodyVelocity.Velocity = moveDirection
    bodyGyro.CFrame = Camera.CFrame
end

-- ESP
local espObjects = {}
local function createESP(player)
    if player == LocalPlayer then return end
    
    local esp = Instance.new("BillboardGui")
    esp.Name = "ESP_" .. player.Name
    esp.Size = UDim2.new(0, 200, 0, 50)
    esp.AlwaysOnTop = true
    esp.Adornee = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    
    local textLabel = Instance.new("TextLabel")
    textLabel.Size = UDim2.new(1, 0, 1, 0)
    textLabel.BackgroundTransparency = 1
    textLabel.Text = player.Name
    textLabel.TextColor3 = settings.espColor
    textLabel.Font = Enum.Font.SourceSansBold
    textLabel.TextSize = 16
    textLabel.TextStrokeTransparency = 0
    textLabel.Parent = esp
    
    local distanceLabel = Instance.new("TextLabel")
    distanceLabel.Size = UDim2.new(1, 0, 0, 20)
    distanceLabel.Position = UDim2.new(0, 0, 1, 0)
    distanceLabel.BackgroundTransparency = 1
    distanceLabel.Text = ""
    distanceLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    distanceLabel.Font = Enum.Font.SourceSans
    distanceLabel.TextSize = 12
    distanceLabel.Parent = esp
    
    esp.Parent = ScreenGui
    espObjects[player] = esp
end

local function updateESP()
    if not settings.espEnabled then
        for _, esp in pairs(espObjects) do
            esp.Enabled = false
        end
        return
    end
    
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local character = player.Character
            local rootPart = character and character:FindFirstChild("HumanoidRootPart")
            local esp = espObjects[player]
            
            if character and rootPart then
                if not esp then
                    createESP(player)
                    esp = espObjects[player]
                end
                
                esp.Adornee = rootPart
                esp.Enabled = true
                
                -- Distance check
                local localRootPart = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                local distance = math.huge
                if localRootPart then
                    distance = (localRootPart.Position - rootPart.Position).Magnitude
                    if esp:FindFirstChild("TextLabel") then
                        esp.TextLabel.Text = player.Name .. " [" .. math.floor(distance) .. "m]"
                    end
                end
                
                if distance > settings.maxDistance then
                    esp.Enabled = false
                end
            else
                if esp then
                    esp.Enabled = false
                end
            end
        end
    end
end

-- Teleport (Improved)
local function teleportToMouse()
    local mouse = LocalPlayer:GetMouse()
    local target = mouse.Target
    if target then
        local character = LocalPlayer.Character
        if character and character:FindFirstChild("HumanoidRootPart") then
            local newCFrame = target.CFrame + Vector3.new(0, 5, 0)
            character:SetPrimaryPartCFrame(newCFrame)
            -- Also move camera
            Camera.CFrame = CFrame.new(newCFrame.Position, newCFrame.Position + Camera.CFrame.LookVector)
        end
    end
end

-- Teleport to Player
local function teleportToPlayer(player)
    if player and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
        LocalPlayer.Character:SetPrimaryPartCFrame(player.Character.HumanoidRootPart.CFrame + Vector3.new(0, 5, 0))
    end
end

-- Dash
local function dash(direction)
    local character = LocalPlayer.Character
    if not character or dashing then return end
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return end
    
    dashing = true
    local bodyVelocity = Instance.new("BodyVelocity")
    bodyVelocity.MaxForce = Vector3.new(1, 1, 1) * 100000
    bodyVelocity.Velocity = direction * settings.dashSpeed
    bodyVelocity.Parent = rootPart
    
    task.delay(settings.dashDuration, function()
        bodyVelocity:Destroy()
        dashing = false
    end)
end

-- Fullbright
local function setFullbright(enabled)
    if enabled then
        Lighting.Ambient = Color3.new(1, 1, 1)
        Lighting.Brightness = 2
        Lighting.ClockTime = 12
        Lighting.FogEnd = 100000
        Lighting.FogStart = 0
        Lighting.GlobalShadows = false
    else
        Lighting.Ambient = Color3.new(0, 0, 0)
        Lighting.Brightness = 1
        Lighting.ClockTime = 14
        Lighting.FogEnd = 500
        Lighting.FogStart = 0
        Lighting.GlobalShadows = true
    end
end

-- FPS Boost
local function setFPSBoost(enabled)
    if enabled then
        settings.RenderQualityLevel = 1
        Lighting.GlobalShadows = false
        workspace.DescendantAdded:Connect(function(part)
            if part:IsA("BasePart") then
                part.Material = Enum.Material.SmoothPlastic
                part.CastShadow = false
            end
        end)
    else
        settings.RenderQualityLevel = 10
        Lighting.GlobalShadows = true
    end
end

